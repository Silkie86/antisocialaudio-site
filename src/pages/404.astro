---
// Not-found page. Cloudflare serves the built 404.html for any missing URL (not_found_handling in wrangler.jsonc),
// so every link here is root-relative and the page is kept out of search results.
import Base from '../layouts/Base.astro';
import { site, workshop, hourlyRate, gbp } from '../data/site';
import { packHours, listJoin } from '../components/home/pricing';

const ways = [
  {
    key: 'lessons',
    href: '/#lessons',
    kick: 'Online · one-to-one',
    title: '1:1 Lessons',
    text: `Personalised lessons with ${site.tutor.alias}, from the basics to advanced techniques.`,
    meta: `${gbp(hourlyRate)} per hour, or less with a pack`,
    lead: true,
  },
  {
    key: 'workshops',
    href: '/workshops/',
    kick: workshop.where,
    title: 'Workshops',
    text: `The ${workshop.title}. ${workshop.points[0]}.`,
    meta: `${gbp(workshop.price)} per masterclass`,
  },
  {
    key: 'book',
    href: '/book/',
    kick: 'Booking',
    title: 'Book a session',
    // "a 5- or 10-hour pack" (suspended hyphen on every pack size but the last)
    text: `Book a single lesson, a ${listJoin(packHours.map((h) => `${h}-`), 'or')}hour pack, or a place on a workshop.`,
    meta: 'Start with a free 30-min consult',
  },
] as const;
---
<Base title="Page not found" description={`This page could not be found. Find one-to-one lessons, workshops and booking on ${site.name}.`} noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="wrap">
      <div class="nf-top">
        <div>
          <p class="kick">Error 404 · Page not found</p>
          <h1 id="nf-title">Lost in the <span class="hl">mix.</span></h1>
        </div>
        <div class="nf-side">
          <p>We can’t find that page. It may have moved when we rebuilt the site, or the link might have a typo.</p>
          <div class="nf-btns">
            <a class="btn btn--yellow" href="/">Back to the homepage</a>
            <a class="nf-link" href="/faq/">Read the FAQ</a>
          </div>
        </div>
      </div>

      {/* A bass wave that drops out in the middle: the signal is lost, like the page. */}
      <div class="drop">
      <svg class="wave" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="w2" d="M0 50Q12 14 24 50Q36 88 48 50Q60 12 72 50Q84 86 96 50Q108 22 120 50Q132 72 144 50Q156 36 168 50Q180 58 192 50Q204 46 216 50L384 50Q396 54 408 50Q420 42 432 50Q444 64 456 50Q468 28 480 50Q492 80 504 50Q516 16 528 50Q540 90 552 50Q564 10 576 50Q588 92 600 50" />
        <path d="M0 50Q15 0 30 50Q45 104 60 50Q75 4 90 50Q105 92 120 50Q135 18 150 50Q165 74 180 50Q195 38 210 50Q222 56 234 50L366 50Q378 44 390 50Q405 62 420 50Q435 26 450 50Q465 84 480 50Q495 8 510 50Q525 100 540 50Q555 -2 570 50Q585 98 600 50" />
      </svg>
      <span class="code" aria-hidden="true">404</span>
      </div>

      <h2 class="pick-t">Where to next?</h2>
      <ul class="ways">
        {ways.map((w) => (
          <li class:list={['way', { 'way--lead': 'lead' in w && w.lead }]}>
            <span class="ico" aria-hidden="true">
              {w.key === 'lessons' && <svg viewBox="0 0 24 24" focusable="false"><path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3" y="14" width="4" height="7" rx="1.5" /><rect x="17" y="14" width="4" height="7" rx="1.5" /></svg>}
              {w.key === 'workshops' && <svg viewBox="0 0 24 24" focusable="false"><rect x="2" y="6" width="14" height="12" rx="2" /><path d="M16 10.5 22 7v10l-6-3.5z" /></svg>}
              {w.key === 'book' && <svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="4.5" width="18" height="16" rx="2.5" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4M8 14h2M14 14h2M8 17h2" /></svg>}
            </span>
            <p class="kick">{w.kick}</p>
            <h3><a href={w.href}>{w.title}</a></h3>
            <p class="text">{w.text}</p>
            <div class="way-foot">
              <p class="meta">{w.meta}</p>
              <span class="arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { background: radial-gradient(70% 90% at 90% 0%, color-mix(in srgb, var(--green) 38%, transparent), transparent 62%); }
  .nf > .wrap { padding-block: clamp(32px, 5vw, 64px) clamp(56px, 8vw, 96px); }
  .nf-top { display: grid; gap: 20px; align-items: end; }
  @media (min-width: 900px) { .nf-top { grid-template-columns: 1.3fr 1fr; gap: 48px; } .nf-side { padding-bottom: 10px; } }
  h1 { font-size: clamp(2.75rem, 7vw, 5.5rem); font-weight: 900; letter-spacing: -0.045em; line-height: 0.94; margin-top: 12px; }
  .hl { color: var(--yellow); }
  .nf-side p { font-size: clamp(1rem, 1.6vw, 1.125rem); color: var(--muted); max-width: 32em; text-wrap: pretty; }
  .nf-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 18px; }
  .nf-link { padding-block: 4px; color: var(--yellow); font-weight: 600; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .nf-link:hover { color: var(--white); }

  /* Dropout wave with the error code sitting in the silence */
  .drop { position: relative; margin: clamp(28px, 4vw, 48px) 0 clamp(24px, 3vw, 36px); }
  .wave { display: block; width: 100%; height: clamp(56px, 8vw, 96px); overflow: visible; }
  .wave path { fill: none; stroke: var(--yellow); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .wave .w2 { stroke: var(--green); stroke-width: 3; }
  .code {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, calc(-100% - 6px));
    color: var(--muted); font-size: clamp(0.8rem, 1.6vw, 1rem); font-weight: 800; letter-spacing: 0.3em; line-height: 1; padding-left: 0.3em;
  }

  .pick-t { margin-bottom: 18px; font-size: clamp(1.35rem, 3vw, 1.75rem); line-height: 1.1; }

  /* Three ways out: the whole card is the link (stretched from the heading link) */
  .ways { display: grid; gap: 16px; }
  @media (min-width: 880px) { .ways { grid-template-columns: repeat(3, 1fr); } }
  .way {
    position: relative; display: flex; flex-direction: column; gap: 10px;
    padding: clamp(20px, 3vw, 28px);
    background: var(--panel); border: 1px solid var(--nav); border-radius: var(--radius);
    transition: border-color .2s, transform .2s;
  }
  .way:hover { border-color: var(--yellow); transform: translateY(-3px); }
  .way:focus-within { border-color: var(--yellow); }
  .way--lead { background: var(--green); border-color: var(--green); }
  .way--lead .kick { color: var(--white); }
  .way--lead .kick::before { color: var(--yellow); }
  .ico { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 6px; border-radius: 12px; background: var(--yellow); color: var(--ink); }
  .ico svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .way h3 { font-size: clamp(1.45rem, 2.6vw, 1.75rem); }
  .way h3 a::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .way h3 a:focus-visible { outline: none; }
  .way h3 a:focus-visible::after { outline: 3px solid var(--yellow); outline-offset: 3px; }
  .text { color: var(--muted); text-wrap: pretty; }
  .way--lead .text { color: var(--paper); }
  .way-foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); }
  .meta { color: var(--white); font-size: 0.9rem; font-weight: 600; text-wrap: balance; }
  .arrow {
    flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 2px solid var(--yellow); color: var(--yellow);
    transition: transform .2s, background-color .2s, color .2s;
  }
  .arrow svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .way:hover .arrow { background: var(--yellow); color: var(--ink); transform: translateX(4px); }

  @media (prefers-reduced-motion: reduce) {
    .way:hover { transform: none; }
    .way:hover .arrow { transform: none; }
  }
</style>
