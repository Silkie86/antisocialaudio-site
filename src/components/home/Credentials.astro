---
// "Taught by Silkie": tutor credentials. The DJ mention is deliberately one quiet line.
import { site } from '../../data/site';
---
<section class="wrap" aria-labelledby="tutor-title">
  <div class="cred">
    <div class="cred-who">
      <p class="kick">Your tutor</p>
      <h2 id="tutor-title">Taught by {site.tutor.alias}</h2>
      <p>{site.tutor.name} aka {site.tutor.alias} has been producing dubstep in the UK for {site.tutor.years} years. As a <strong>Bitwig Certified Trainer</strong> he teaches music theory, sound design, mixing and mastering across multiple DAWs, tailored to every skill level.</p>
    </div>
    <ul class="stats">
      <li><b>{site.tutor.years}</b><span>years producing dubstep</span></li>
      <li><b>Bitwig</b><span>Certified Trainer</span></li>
    </ul>
    <div class="labels">
      <p class="kick">Released on</p>
      <ul>
        {site.labels.map((label) => <li>{label}</li>)}
      </ul>
      <p class="dj">{site.tutor.alias} also DJs: <a href="/dj-bookings/">booking enquiries</a></p>
    </div>
  </div>
</section>

<style>
  .cred {
    display: grid; gap: 28px;
    background: var(--panel); border: 1px solid var(--nav); border-radius: 24px; padding: clamp(22px, 4.5vw, 48px);
  }
  .cred-who { display: grid; gap: 12px; align-content: start; }
  .cred-who h2 { font-size: clamp(2rem, 5.2vw, 3.4rem); }
  .cred-who p:not(.kick) { color: var(--muted); max-width: 36em; text-wrap: pretty; }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-self: end; }
  .stats li {
    display: grid; align-content: space-between; gap: 2px; min-height: 118px; padding: 16px;
    background: var(--yellow); color: var(--ink); border-radius: 14px;
  }
  .stats b { color: var(--ink); font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1; }
  .stats span { font-size: 0.86rem; font-weight: 600; line-height: 1.3; }
  .labels { grid-column: 1 / -1; display: grid; gap: 10px; border-top: 1px solid var(--line); padding-top: 22px; }
  .labels ul { display: flex; flex-wrap: wrap; gap: 4px 0; }
  .labels li {
    margin-right: 1em; color: var(--white); font-weight: 800; font-size: clamp(1.1rem, 2.8vw, 1.8rem);
    letter-spacing: -0.02em; line-height: 1.25; text-transform: uppercase;
  }
  .labels li::before { content: "\2726"; content: "\2726" / ""; color: var(--yellow); font-size: 0.6em; margin-right: 0.6em; vertical-align: 0.25em; }
  .dj { margin-top: 8px; color: var(--muted); font-size: 0.9rem; }
  .dj a { display: inline-block; padding-block: 4px; color: var(--yellow); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .dj a:hover { color: var(--white); }
  @media (min-width: 820px) { .cred { grid-template-columns: 1.25fr 1fr; column-gap: 48px; } }
</style>
